# Variables de entorno — Protocolo Emocional
# Copiar este archivo a .env y completar los valores

# Canal de notificación al amigo: telegram | whatsapp | sms | email | push
VITE_NOTIFICATION_CHANNEL=telegram

# Endpoint del servicio de notificaciones (ej. webhook de Telegram Bot o función serverless)
VITE_NOTIFICATION_ENDPOINT=

# Token del bot de Telegram (si se usa Telegram)
VITE_TELEGRAM_BOT_TOKEN=

# Chat ID del amigo destinatario (si se usa Telegram)
VITE_TELEGRAM_CHAT_ID=
